# ─────────────────────────────────────────────────────────────
# Payload CMS — copy this file to `.env.local` and fill in real
# values. NEVER commit `.env.local` (it is gitignored).
# ─────────────────────────────────────────────────────────────

# MongoDB connection string (MongoDB Atlas or self-hosted).
# Example Atlas: mongodb+srv://USER:PASS@cluster0.xxxx.mongodb.net/portfolio?retryWrites=true&w=majority
DATABASE_URI=

# Long random string used to sign/secure Payload data (JWT, etc.).
# Generate one with:  openssl rand -base64 32
PAYLOAD_SECRET=

# Public URL the site is served from (used for admin, links, SEO, sitemap).
# Local dev: http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Vercel Blob file storage ──
# Read-write token from Vercel dashboard → Storage → your Blob store (Public) → .env.local tab.
# Leave empty to store uploads on local disk (dev only — Vercel's disk is not persistent).
BLOB_READ_WRITE_TOKEN=
